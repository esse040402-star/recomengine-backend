# RecomEngine 회원가입/비회원 진단 데이터 저장 기능 환경변수 예시
# 실제 비밀값은 로컬 .env 또는 배포 환경에만 입력하고 GitHub에는 올리지 마세요.

# true: Supabase 없이 메모리 내 모의 DB로 실행 (서버 재시작 시 데이터 초기화)
# 실제 Supabase DB를 사용할 때는 false로 변경하고 아래 Supabase/세션 값을 설정합니다.
USE_MOCK_DB=true

# --- Supabase ---
SUPABASE_URL=
# service_role 키는 서버 전용이며 프론트엔드에 노출하지 마세요.
SUPABASE_SERVICE_KEY=
# 실제 DB 모드에서 회원가입/로그인 인증에 사용하는 anon public 키
SUPABASE_ANON_KEY=

# --- 로그인 세션 쿠키 ---
# 실제 DB 모드에서는 필수입니다. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
SESSION_DAYS=30
# HTTPS 배포 환경에서 true
COOKIE_SECURE=false

# --- RAWG 게임 데이터 API (선택) ---
RAWG_API_KEY=

# --- IGDB 게임 데이터 API (선택) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Ollama 심화 설문 생성 ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONCURRENCY=2

# --- Steam 연동 (선택) ---
STEAM_API_KEY=

# --- 기타 ---
# 관리자 API 보호용 토큰. 비워두면 관리자 API가 비활성화될 수 있습니다.
ADMIN_TOKEN=
# 프론트엔드와 백엔드가 서로 다른 출처에서 실행될 때 허용할 origin 목록
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
