# 실제 값은 로컬 환경에서만 설정하세요. 이 파일에는 비밀값을 넣지 마세요.
USE_MOCK_DB=true

# Supabase (실제 DB 연결 시 설정)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# 로그인 세션
SESSION_SECRET=
SESSION_DAYS=30
COOKIE_SECURE=false

# 외부 게임 데이터 / AI 연동 (사용하는 기능에 한해 설정)
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONCURRENCY=2
STEAM_API_KEY=
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
