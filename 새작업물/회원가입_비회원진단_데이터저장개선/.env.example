# RecomEngine 회원가입/비회원 진단 데이터 저장 기능 작업물 환경변수 예시
# 실제 비밀값은 로컬 .env 또는 배포 환경에만 입력하고 GitHub에 올리지 마세요.

# 데이터베이스 모드
USE_MOCK_DB=true

# Supabase 실제 DB 연결 시 설정
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# 로그인 세션 및 쿠키
SESSION_SECRET=
SESSION_DAYS=30
COOKIE_SECURE=false

# 외부 게임 데이터 API (필요한 연동만 설정)
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
STEAM_API_KEY=

# Ollama 로컬 AI (미설치/미실행 시 AI 설문은 대체 문항 흐름으로 진행될 수 있음)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONCURRENCY=2

# 관리자 및 프론트엔드 접근 허용
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

